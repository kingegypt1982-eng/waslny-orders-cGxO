generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  CAPTAIN
  ADMIN
}

enum CaptainStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  SEARCHING_CAPTAIN
  ACCEPTED
  ARRIVED_AT_PICKUP
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ShipmentCategory {
  PAPERS
  MATERIALS
  GOODS
  SPARE_PARTS
  PACKAGE
  OTHER
  MEDICINES
  PURCHASES
  FOOD
  ELECTRONICS
}

enum PolicyAcknowledgementType {
  TERMS_CAPTAIN
  TERMS_CLIENT
  SENSITIVE_CATEGORY
  PURCHASE_INVOICE
}

enum PurchaseInvoiceStatus {
  SUBMITTED
  CONFIRMED
  DISPUTED
}

enum WalletTransactionType {
  TOP_UP
  ORDER_COMMISSION
  COMMISSION_REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER
  PAYMENT
  SYSTEM
  CAPTAIN
  ADMIN
}

enum EventActor {
  ADMIN
  CAPTAIN
  CLIENT
  SYSTEM
}

enum ProofType {
  PICKUP
  DELIVERY
}

enum TopUpStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  googleId               String?                 @unique
  passwordHash           String?
  name                   String
  phone                  String?
  role                   UserRole                @default(CLIENT)
  suspendedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  captain                CaptainProfile?
  wallet                 Wallet?
  notifications          Notification[]
  topUps                 TopUp[]
  clientOrders           Order[]                 @relation("ClientOrders")
  captainOrders          Order[]                 @relation("CaptainOrders")
  walletTransactions     WalletTransaction[]
  payments               PaymentIntent[]
  policyAcknowledgements PolicyAcknowledgement[]
  capturedInvoices       PurchaseInvoice[]       @relation("CapturedInvoices")
  passwordResetTokens    PasswordResetToken[]
  skippedOrders          OrderSkip[]             @relation("CaptainOrderSkips")
  sentMessages           ChatMessage[]           @relation("Sender")
  receivedMessages       ChatMessage[]           @relation("Receiver")
}

model CaptainProfile {
  id                        String        @id @default(cuid())
  userId                    String        @unique
  status                    CaptainStatus @default(PENDING)
  nationalIdDocument        String        @default("PENDING_UPLOAD")
  licenseDocument           String        @default("PENDING_UPLOAD")
  vehicleDocument           String        @default("PENDING_UPLOAD")
  nationalIdBackDocument    String        @default("PENDING_UPLOAD")
  licenseBackDocument       String        @default("PENDING_UPLOAD")
  vehicleBackDocument       String        @default("PENDING_UPLOAD")
  vehicleType               String?
  vehiclePlate              String?
  vehicleMake               String?
  vehicleModel              String?
  vehicleColor              String?
  profilePhotoDocument      String        @default("PENDING_UPLOAD")
  dateOfBirth               DateTime?
  nationalIdEncrypted        String?
  nationalIdHash            String?       @unique
  nationalIdLast4           String?
  licenseNumber             String?       @unique
  vehicleRegistrationNumber String?
  governorate               String?
  rating                    Float         @default(0)
  totalTrips                Int           @default(0)
  isOnline                  Boolean       @default(false)
  serviceRadiusKm           Float         @default(10)
  lastLat                   Float?
  lastLng                   Float?
  lastSeenAt                DateTime?
  fcmToken                  String?
  approvedAt                DateTime?
  reviewedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("EGP")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WalletTransaction {
  id        String                @id @default(cuid())
  userId    String
  orderId   String?
  topUpId   String?               @unique
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(12, 2)
  currency  String                @default("EGP")
  note      String?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  topUp     TopUp?                @relation(fields: [topUpId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId])
}

model TopUp {
  id                    String             @id @default(cuid())
  userId                String
  amount                Decimal            @db.Decimal(12, 2)
  creditAmount          Decimal            @db.Decimal(12, 2)
  chargeAmount          Decimal            @db.Decimal(12, 2)
  feeAmount             Decimal            @db.Decimal(10, 2)
  feePercent            Decimal            @db.Decimal(5, 2)
  feeFixed              Decimal            @db.Decimal(10, 2)
  currency              String             @default("EGP")
  status                TopUpStatus        @default(PENDING)
  providerSessionId     String?
  providerOrderRef      String             @unique
  providerTransactionId String?            @unique
  checkoutUrl           String?
  createdAt             DateTime           @default(now())
  paidAt                DateTime?
  failureReason         String?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction     WalletTransaction?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Order {
  id                     String                  @id @default(cuid())
  reference              String                  @unique @default(cuid())
  clientId               String
  captainId              String?
  status                 OrderStatus             @default(PENDING)
  pickupLabel            String
  pickupLatitude         Float
  pickupLongitude        Float
  deliveryLabel          String
  deliveryLatitude       Float
  deliveryLongitude      Float
  category               ShipmentCategory
  description            String
  recipientName          String
  recipientPhone        String
  distanceKm             Decimal                 @db.Decimal(9, 2)
  price                  Decimal                 @db.Decimal(12, 2)
  commission             Decimal                 @db.Decimal(5, 2)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  acceptedAt             DateTime?
  deliveredAt            DateTime?
  completedAt            DateTime?
  client                 User                    @relation("ClientOrders", fields: [clientId], references: [id])
  captain                User?                   @relation("CaptainOrders", fields: [captainId], references: [id])
  transactions           WalletTransaction[]
  payments               PaymentIntent[]
  events                 OrderEvent[]
  proofs                 OrderProof[]
  skips                  OrderSkip[]    @relation("OrderSkips")
  policyAcknowledgements PolicyAcknowledgement[]
  purchaseInvoice        PurchaseInvoice?
  ratings                OrderRating[]
  estimatedBudget        Decimal?                @db.Decimal(12, 2)

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([captainId, status])
}

model OrderRating {
  id        String   @id @default(cuid())
  orderId   String
  raterId   String
  rateeId   String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, raterId])
  @@index([rateeId, createdAt])
}

model OrderSkip {
  id        String   @id @default(cuid())
  orderId   String
  captainId String
  createdAt DateTime @default(now())
  order     Order    @relation("OrderSkips", fields: [orderId], references: [id], onDelete: Cascade)
  captain   User     @relation("CaptainOrderSkips", fields: [captainId], references: [id], onDelete: Cascade)

  @@unique([orderId, captainId])
  @@index([captainId, createdAt])
}

model OrderEvent {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorRole  EventActor
  note       String?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderProof {
  id           String    @id @default(cuid())
  orderId      String
  type         ProofType
  photoPath    String?
  capturedById String
  note         String?
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([orderId])
}

model PolicyAcknowledgement {
  id             String                    @id @default(cuid())
  userId         String
  type           PolicyAcknowledgementType
  policyVersion  String
  orderId        String?
  category       ShipmentCategory?
  idempotencyKey String                    @unique
  createdAt      DateTime                  @default(now())
  ip             String?
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, type, createdAt])
  @@index([orderId, type])
}

model PurchaseInvoice {
  id                   String                @id @default(cuid())
  orderId              String                @unique
  capturedById         String
  amount               Decimal               @db.Decimal(12, 2)
  currency             String                @default("EGP")
  photoPath            String
  note                 String?
  status               PurchaseInvoiceStatus @default(SUBMITTED)
  clientRespondedAt    DateTime?
  clientResponseReason String?
  createdAt            DateTime              @default(now())
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capturedBy           User                  @relation("CapturedInvoices", fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([capturedById, createdAt])
}

model PricingSettings {
  id                   String             @id @default("default")
  basePrice            Decimal            @default(30) @db.Decimal(10, 2)
  pricePerKm           Decimal            @default(8) @db.Decimal(10, 2)
  commissionPercent    Decimal            @default(10) @db.Decimal(5, 2)
  minimumWalletBalance Decimal            @default(0) @db.Decimal(12, 2)
  minRadiusKm          Decimal            @default(0.5) @db.Decimal(6, 2)
  maxRadiusKm          Decimal            @default(15) @db.Decimal(6, 2)
  minTopUpAmount       Decimal            @default(50) @db.Decimal(10, 2)
  maxTopUpAmount       Decimal            @default(10000) @db.Decimal(12, 2)
  paymentFeePercent    Decimal            @default(2.5) @db.Decimal(5, 2)
  paymentFeeFixed      Decimal            @default(0) @db.Decimal(10, 2)
  disabledCategories   ShipmentCategory[] @default([])
  currency             String             @default("EGP")
  updatedAt            DateTime           @updatedAt
}

model PaymentIntent {
  id                String        @id @default(cuid())
  userId            String
  orderId           String?
  provider          String        @default("KASHIER")
  providerReference String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("EGP")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

/// Represents a single chat message between a client and a captain
model ChatMessage {
  id         String      @id @default(cuid())
  senderId   String
  receiverId String
  role       String // 'CLIENT' or 'CAPTAIN'
  content    String
  type       MessageType @default(TEXT)
  createdAt  DateTime    @default(now())
  readBy     String?
  readAt     DateTime?

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}
