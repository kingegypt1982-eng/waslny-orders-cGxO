NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://waslny_orders_user:CHANGE_ME_STRONG_PASSWORD@localhost:5435/waslny_orders_dev?schema=public"
REDIS_URL="redis://127.0.0.1:6380"
JWT_SECRET=CHANGE_ME_RANDOM_32_PLUS_CHARS
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (takes precedence over CLIENT_ORIGIN).
# Required in production: the app refuses to boot without it when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Seed admin account (used by `npm run prisma:seed`, which `prisma migrate dev`
# also runs). ADMIN_PASSWORD is required in every environment — including
# development — and has no default. Replace the placeholder with a unique value.
ADMIN_EMAIL=admin@waslny.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Kashier test-environment credentials (Sandbox only — never Live keys here).
# Required at boot, except KASHIER_WEBHOOK_URL which may stay empty locally.
KASHIER_MERCHANT_ID=MID-XXXX-XXX
KASHIER_API_KEY=your-test-payment-api-key
KASHIER_SECRET_KEY=your-test-secret-key
KASHIER_BASE_URL=https://test-api.kashier.io
# Fallback only: the API sends the payer back to
# `<request Origin>/payment-redirect` when that origin is in CORS_ORIGINS,
# otherwise to `<CLIENT_ORIGIN>/payment-redirect`. This value is the last
# resort (e.g. no browser Origin and no CLIENT_ORIGIN).
KASHIER_REDIRECT_URL=http://localhost:5173/payment-redirect
KASHIER_WEBHOOK_URL=
# Google sign-in: OAuth 2.0 Web client ID used as the ID-token audience.
# Required at boot when /auth/google is used; requests fail clearly if empty.
GOOGLE_CLIENT_ID=
# AES-256-GCM key for captain national IDs. Base64-encoded 32 bytes (256-bit).
# Required at boot: the API refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional NATIONAL_ID_HASH_KEY (also base64 32 bytes) may be set to keep the
# HMAC key separate from the encryption key; otherwise it falls back to this one.
NATIONAL_ID_ENCRYPTION_KEY=

# Firebase configuration (optional - enables secure chat feature)
# Set to a valid path when ready to deploy chat feature. Chat is disabled by default.
# FIREBASE_SERVICE_ACCOUNT_PATH=
#   Full path to the Firebase service account JSON file (e.g., /path/to/serviceAccount.json)
# FIREBASE_DATABASE_URL=
#   Firebase Realtime Database URL (e.g., https://waslny-c6ffb-default-rtdb.europe-west1.firebasedatabase.app)
# CHAT_ENABLED=
#   Set to true to enable the chat feature (default: false)